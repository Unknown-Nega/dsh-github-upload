{
  "name": "dsh-github-upload",
  "version": "0.1.0",
  "description": "在 DSH 内登录 GitHub、让当前模型生成插件说明，并把插件一次性发布到新仓库或已有仓库。",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "keywords": [
    "dsh",
    "github",
    "publish",
    "readme",
    "plugin"
  ],
  "license": "MIT"
}
